# ==============================================================================
# Anti-Proxy Attendance System - Backend Environment Configuration Template
# ==============================================================================

APP_NAME=Anti-Proxy Attendance System
APP_ENV=development
DEBUG=true

MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=anti_proxy_attendance
EVENTS_COLLECTION=attendance_events

# JWT Secret: Minimum 32 characters
JWT_SECRET_KEY=replace_with_a_secure_random_at_least_32_chars_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Machine Ingestion API Key for POST /api/v1/events
VISION_SERVICE_API_KEY=replace_with_secure_random_vision_api_key_secret_here
REQUIRE_CAMERA_AUTH=true

EVENTS_MAX_PAYLOAD_BYTES=65536
EVENTS_RATE_LIMIT_PER_MINUTE=600

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
