# ==============================================================================
# Anti-Proxy Attendance System - Environment Configuration Template
# Copy this file to .env and populate with secure, high-entropy secrets.
# ==============================================================================

# Application Settings
# The name shown in the web interface, the browser tab and the API title.
# Change it here and rebuild (docker compose up -d --build) to rename the product.
APP_NAME=Anti-Proxy Attendance System
APP_ENV=development
DEBUG=true

# MongoDB Database Configuration (Docker Compose & Local Dev)
# Root Administrative Credentials (used only by Docker initialization)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=replace_with_a_secure_mongo_root_password_here

# Application Unprivileged Database User
MONGO_APP_USERNAME=antiproxy_user
MONGO_APP_PASSWORD=replace_with_a_secure_mongo_app_password_here
DATABASE_NAME=anti_proxy_attendance
EVENTS_COLLECTION=attendance_events

# Connection string for Backend:
# For local bare-metal: mongodb://localhost:27017
# For Docker Compose: mongodb://${MONGO_APP_USERNAME}:${MONGO_APP_PASSWORD}@mongodb:27017/${DATABASE_NAME}?authSource=${DATABASE_NAME}
MONGODB_URL=mongodb://localhost:27017

# JWT Authentication (HS256)
# SECURITY REQUIREMENT: Must be at least 32 characters long.
# Never use default or predictable keys in production!
JWT_SECRET_KEY=replace_with_a_secure_random_at_least_32_chars_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Service-to-Service / Vision Camera Credentials
# Shared secret API key used by the Vision Service to authenticate POST /api/v1/events
VISION_SERVICE_API_KEY=replace_with_secure_random_vision_api_key_secret_here
# Optional precomputed SHA-256 hex digest of the vision service key
# VISION_SERVICE_API_KEY_HASH=
# Optional per-camera key binding mapping in JSON format: {"CAM_ROOM_101_DOOR": "key1"}
# VISION_CAMERA_KEYS={}
REQUIRE_CAMERA_AUTH=true

# Recognition result signing (shared by backend and vision-service) - REQUIRED
# The vision service signs every recognition result with this key and the
# backend verifies it before marking attendance. Both services refuse to
# start if it is missing, shorter than 32 characters, or still the placeholder
# below. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
RECOGNITION_SIGNING_KEY=replace_with_output_of_the_command_above
# Local development / tests only: set to true to skip the check above.
# Never enable this in a deployed environment.
ALLOW_INSECURE_RECOGNITION_KEY=false

# First administrator. Used only at start-up and only when no administrator
# account exists yet. There is no default password: leave both empty unless you
# are creating the first admin, and remove them again once it exists (the
# backend logs a warning while they are still set). The password must be at
# least 12 characters and has to be changed at first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Public registration: requests per client address per minute, across the
# student, teacher and account registration routes together.
REGISTRATION_RATE_LIMIT_PER_MINUTE=5

# Passive liveness (anti-spoofing) gate, used by both the backend and the
# vision service. See docs/adr/ADR-011-passive-liveness-gate.md.
#   observe  - every recognized face is checked and logged, nothing is blocked
#   enforce  - a face that fails the check is never marked; the backend accepts
#              only results the vision service signed as "liveness passed"
LIVENESS_MODE=observe
# Minimum "real face" score (0 to 1). Provisional until calibrated on a
# measured attack set (docs/evaluation/liveness_capture_guide.md).
LIVENESS_THRESHOLD=0.5

# Ingestion Protections
EVENTS_MAX_PAYLOAD_BYTES=65536
EVENTS_RATE_LIMIT_PER_MINUTE=600
EVENT_TIMESTAMP_VALIDATION_ENABLED=true

# CORS Configuration (Comma-separated origins)
# NOTE: Wildcard '*' with credentials is automatically rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:8080,http://127.0.0.1:5173

# Biometric & Computer Vision Configuration
RECOGNITION_SIMILARITY_THRESHOLD=0.50
RECOGNITION_MIN_MARGIN=0.15
