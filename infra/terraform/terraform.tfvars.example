# Copy to terraform.tfvars (ignored by git) and fill in. Nothing here is secret.

# "on_demand" (what this project uses): started and stopped by hand with
# tf.py start / tf.py stop, and stopped automatically every night.
# "always_on" would remove the nightly stop.
run_mode = "on_demand"

site_host = "your-subdomain.duckdns.org"

# Budget alerts are emailed here.
alert_email = "you@example.com"

# Atlas console -> Organization Settings -> Organization ID
atlas_org_id = "000000000000000000000000"

# Trial runs: uncomment to use Let's Encrypt's staging service, whose
# certificates browsers do not trust but which has no weekly limit.
# acme_ca = "https://acme-staging-v02.api.letsencrypt.org/directory"
